#!/usr/bin/env bash
# ttytree :: renderer
#
# Prints the work tree for a Claude Code session. Pure shell — no model call,
# no tokens. `/ttytree` (the skill) is what *updates* the tree; this is
# what displays it, and you can run it any time from any terminal.
#
#   ttytree                 this terminal's session
#   ttytree <name>          a session by project name
#   ttytree --all           one line per session (the board)
#   ttytree --all --full    every tree in full
#   ttytree --serve [port]  live dashboard in the browser (default 7777)
#   ttytree --html          write the dashboard to stdout
#   ttytree --session <id>  a specific session
#   ttytree --next          only what's actionable right now
#   ttytree --json          machine-readable output (see docs/INTEGRATION.md)
#   ttytree --watch [secs]  live view, redraws every few seconds (default 5)
#   ttytree --statusline    2-3 line summary for Claude Code's statusLine
#   ttytree --events [n]    raw facts captured by the Stop hook
#   ttytree --path          print the tree file path (for editing)
#   ttytree --no-color      plain text
#   ttytree --no-icons      state marks only, no category icons
#   ttytree --ascii         ASCII marks too, for terminals without unicode

set -uo pipefail
# resolve through symlinks — this file is installed as a symlink
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
. "$SELF_DIR/../lib/common.sh"

COLOR=1
[ -t 1 ] || COLOR=0
[ -n "${NO_COLOR:-}" ] && COLOR=0

MODE=session
ARG=""
JSON=0
FULL=0
# Category icons need a UTF-8 terminal; TTYTREE_ICONS=0/1 overrides the sniff.
ASCII=0
tt_unicode_ok || ASCII=1
ICONS=$(( ASCII ? 0 : 1 ))
case "${TTYTREE_ICONS:-}" in 0|off|no) ICONS=0 ;; 1|on|yes) ICONS=1 ;; esac
while [ $# -gt 0 ]; do
  case "$1" in
    --all|-a)      MODE=all ;;
    --full|-f)     FULL=1 ;;
    --serve)       MODE=serve; case "${2:-}" in [0-9]*) ARG="$2"; shift ;; esac ;;
    --html)        MODE=html ;;
    --session|-s)  MODE=session; ARG="${2:-}"; shift ;;
    --events|-e)   MODE=events; case "${2:-}" in [0-9]*) ARG="$2"; shift ;; esac ;;
    --path|-p)     MODE=path ;;
    --next|-n)     MODE=next ;;
    --json|-j)     JSON=1 ;;
    --watch|-w)    MODE=watch; case "${2:-}" in [0-9]*) ARG="$2"; shift ;; esac ;;
    --statusline)  MODE=statusline ;;
    --icon-map)    tt_icon_rules; echo; exit 0 ;;
    --no-color)    COLOR=0 ;;
    --icons)       ICONS=1 ;;
    --no-icons)    ICONS=0 ;;
    --ascii)       ASCII=1; ICONS=0 ;;
    -h|--help)     awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
                   exit 0 ;;
    -*)            printf 'ttytree: unknown option %s\n' "$1" >&2
                   printf "try 'ttytree --help'\n" >&2; exit 2 ;;
    *)             ARG="$1" ;;
  esac
  shift
done

if [ "$COLOR" = 1 ]; then
  C_DIM=$'\033[2m'; C_RST=$'\033[0m'; C_B=$'\033[1m'
  C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_RED=$'\033[31m'; C_CYN=$'\033[36m'
else
  C_DIM=""; C_RST=""; C_B=""; C_GRN=""; C_YEL=""; C_RED=""; C_CYN=""
fi

if [ "$ASCII" = 1 ]; then
  G_DONE="x"; G_NOW=">"; G_BLOCK="!"; G_DROP="-"; G_OPEN="o"
  T_LAST='`- '; T_MID='|- '; T_BAR='|  ' 
else
  G_DONE="✔"; G_NOW="▸"; G_BLOCK="⛔"; G_DROP="·"; G_OPEN="○"
  T_LAST="└─ "; T_MID="├─ "; T_BAR="│  "
fi

render_tree() {
  local file="$1"
  awk -v dim="$C_DIM" -v rst="$C_RST" -v bold="$C_B" \
      -v grn="$C_GRN" -v yel="$C_YEL" -v red="$C_RED" \
      -v g_done="$G_DONE" -v g_now="$G_NOW" -v g_block="$G_BLOCK" \
      -v g_drop="$G_DROP" -v g_open="$G_OPEN" \
      -v t_last="$T_LAST" -v t_mid="$T_MID" -v t_bar="$T_BAR" \
      -v icons="$ICONS" -v iconmap="$(tt_icon_rules)" '
    BEGIN {
      n = 0
      nrule = icons ? split(iconmap, rule, ";") : 0
      for (r = 1; r <= nrule; r++) {
        eq = index(rule[r], "=")
        ic[r]  = substr(rule[r], 1, eq - 1)
        pat[r] = substr(rule[r], eq + 1)
      }
    }
    # What kind of work is this? First rule that matches wins.
    # Patterns match at a word start only — otherwise "portable" reads as
    # "table" and "transcripts" as "script". Suffixes are free, so "doc"
    # catches "docs" and "regress" catches "regression".
    function cat(t,   r, lt) {
      if (!icons) return ""
      lt = " " tolower(t) " "
      gsub(/[^a-z0-9]+/, " ", lt)
      for (r = 1; r <= nrule; r++) if (lt ~ (" (" pat[r] ")")) return ic[r] " "
      return "  "
    }
    function glyph(m) {
      if (m == "x") return grn g_done rst
      if (m == "~") return yel bold g_now rst
      if (m == "!") return red g_block rst
      if (m == "-") return dim g_drop rst
      return g_open
    }
    function paint(m, t) {
      if (m == "x") return dim t rst
      if (m == "~") return bold t rst
      if (m == "!") return red t rst
      if (m == "-") return dim t rst
      return t
    }
    # collect items — portable parse (no gawk-only 3-arg match)
    /^[ \t]*- \[.\] / {
      i = 1; ind = 0
      while (i <= length($0)) {
        c = substr($0, i, 1)
        if (c == " ")      { ind += 1; i += 1 }
        else if (c == "\t") { ind += 2; i += 1 }
        else break
      }
      d[n]  = int(ind / 2)
      mk[n] = substr($0, i + 3, 1)
      tx[n] = substr($0, i + 6)
      n++
      next
    }
    END {
      for (i = 0; i < n; i++) {
        # is this the last sibling at its depth?
        last = 1
        for (j = i + 1; j < n; j++) {
          if (d[j] < d[i]) break
          if (d[j] == d[i]) { last = 0; break }
        }
        pre = ""
        for (k = 0; k < d[i]; k++) pre = pre (cont[k] ? dim t_bar rst : "   ")
        conn = last ? dim t_last rst : dim t_mid rst
        printf "%s%s%s %s%s\n", pre, conn, glyph(mk[i]), cat(tx[i]), paint(mk[i], tx[i])
        cont[d[i]] = (last ? 0 : 1)
      }
      if (n == 0) printf "%s(tree is empty — run /ttytree to populate it)%s\n", dim, rst
    }
  ' "$file" 2>/dev/null || sed -n 's/^/  /p' "$file"
}

header() {
  local sid="$1" meta name cwd status tty proj
  meta=$(tt_session_meta "$sid")
  if [ -n "$meta" ]; then
    name=$(printf '%s' "$meta"   | jq -r '.name // "?"')
    cwd=$(printf '%s' "$meta"    | jq -r '.cwd // "?"')
    status=$(printf '%s' "$meta" | jq -r '.status // "?"')
    tty=$(printf '%s' "$meta"    | jq -r '.tty // "-"')
  else
    name="(ended)"; status="gone"; tty="-"
    cwd=$(tail -1 "$(tt_events "$sid")" 2>/dev/null | jq -r '.cwd // "?"' 2>/dev/null)
  fi
  proj=$(basename "${cwd:-?}")
  local tf age=""
  tf=$(tt_tree "$sid")
  if [ -f "$tf" ]; then
    age=" · updated $(tt_ago "$(stat -f %m "$tf" 2>/dev/null || stat -c %Y "$tf" 2>/dev/null || echo 0)") ago"
  fi
  printf '%s%s%s  %s%s · %s · %s%s%s\n' \
    "$C_B" "$proj" "$C_RST" "$C_DIM" "$tty" "$status" "${sid:0:8}" "$age" "$C_RST"
}

footer() {
  local sid="$1" ev tree_mt since turns files dirty
  ev=$(tt_events "$sid"); [ -f "$ev" ] || return 0
  tree_mt=$(stat -f %m "$(tt_tree "$sid")" 2>/dev/null || echo 0)
  since=$(jq -s --argjson t "$tree_mt" '
      [ .[] | select(.ts > $t) ]
      | { turns: length,
          files: ([ .[].files[]? ] | unique | length),
          dirty: (last.dirty // 0) }' "$ev" 2>/dev/null)
  [ -n "$since" ] || return 0
  turns=$(printf '%s' "$since" | jq -r '.turns'); files=$(printf '%s' "$since" | jq -r '.files')
  dirty=$(printf '%s' "$since" | jq -r '.dirty')
  [ "$turns" = "0" ] && [ "$dirty" = "0" ] && return 0
  printf '%s' "$C_DIM"
  if [ "$turns" != "0" ]; then
    printf '   %s turn(s), %s file(s) touched since this tree was updated' "$turns" "$files"
    printf ' — run %s/ttytree%s%s to fold them in' "$C_CYN" "$C_RST" "$C_DIM"
  fi
  [ "$dirty" != "0" ] && printf '\n   %s uncommitted file(s)' "$dirty"
  printf '%s\n' "$C_RST"
}

show_one() {
  local sid="$1" tf
  tf=$(tt_tree "$sid")
  header "$sid"
  if [ -f "$tf" ]; then
    grep -v '^<!--' "$tf" | grep -v '^#' | render_tree /dev/stdin
  else
    printf '   %s(no tree yet — run /ttytree in that session)%s\n' "$C_DIM" "$C_RST"
  fi
  footer "$sid"
}


# Parse tree.md into TSV: depth <TAB> state <TAB> text
parse_items() {
  awk '
    BEGIN { FS = "" }
    /^[ \t]*- \[.\] / {
      i = 1; ind = 0
      while (i <= length($0)) {
        c = substr($0, i, 1)
        if (c == " ")       { ind += 1; i += 1 }
        else if (c == "\t") { ind += 2; i += 1 }
        else break
      }
      m = substr($0, i + 3, 1)
      t = substr($0, i + 6)
      st = "next"
      if (m == "x") st = "done"
      else if (m == "~") st = "in_progress"
      else if (m == "!") st = "blocked"
      else if (m == "-") st = "dropped"
      printf "%d\t%s\t%s\n", int(ind / 2), st, t
    }
  ' "$1" 2>/dev/null
}

json_one() {
  local sid="$1" tf ev meta items tree_mt stale
  tf=$(tt_tree "$sid"); ev=$(tt_events "$sid")
  meta=$(tt_session_meta "$sid")
  [ -n "$meta" ] || meta=$(printf '{"sessionId":"%s","cwd":null,"name":null,"status":"gone","pid":null,"tty":null}' "$sid")

  if [ -f "$tf" ]; then
    tree_mt=$(stat -f %m "$tf" 2>/dev/null || stat -c %Y "$tf" 2>/dev/null || echo 0)
    items=$(parse_items "$tf" | jq -R -s '
      [ split("\n")[] | select(length > 0) | split("\t")
        | { depth: (.[0] | tonumber), state: .[1], text: .[2] } ]')
  else
    tree_mt=0; items='[]'
  fi

  stale=$(jq -s --argjson t "${tree_mt:-0}" '
      [ .[] | select((.ts // 0) > $t and (.cold_start // false) == false) ]
      | { turns: length, files: ([ .[].files[]? ] | unique | length),
          dirty: ((last // {}).dirty // 0) }' "$ev" 2>/dev/null) || stale='{"turns":0,"files":0,"dirty":0}'
  [ -n "$stale" ] || stale='{"turns":0,"files":0,"dirty":0}'

  printf '%s' "$meta" | jq -c \
    --argjson items "$items" --argjson stale "$stale" --argjson updated "${tree_mt:-0}" \
    --arg has_tree "$([ -f "$tf" ] && echo true || echo false)" '
    # convenience fields drop a redundant state prefix ("BLOCKED: x" -> "x");
    # items[].text stays verbatim.
    def unprefix: sub("^[[:space:]]*(BLOCKED|Blocked|blocked|DROPPED|Dropped|dropped|TODO|Todo|NEXT|Next)[[:space:]]*[:-][[:space:]]*"; "");
    {
      session_id: .sessionId,
      name:       .name,
      cwd:        .cwd,
      project:    (if .cwd then (.cwd | split("/") | last) else null end),
      tty:        .tty,
      pid:        .pid,
      session_status: .status,
      has_tree:   ($has_tree == "true"),
      tree_updated: $updated,
      items:      $items,
      summary: {
        done:        ([ $items[] | select(.state == "done") ]        | length),
        in_progress: ([ $items[] | select(.state == "in_progress") ] | length),
        next:        ([ $items[] | select(.state == "next") ]        | length),
        blocked:     ([ $items[] | select(.state == "blocked") ]     | length),
        dropped:     ([ $items[] | select(.state == "dropped") ]     | length)
      },
      current: ([ $items[] | select(.state == "in_progress") | .text | unprefix ] | last),
      blocked: [ $items[] | select(.state == "blocked") | .text | unprefix ],
      next:    [ $items[] | select(.state == "next") | .text | unprefix ],
      since_update: $stale
    }'
}

emit_json() {
  local first=1
  printf '{"version":1,"generated_at":%s,"sessions":[' "$(date +%s)"
  for sid in "$@"; do
    [ "$first" = 1 ] || printf ','
    json_one "$sid"
    first=0
  done
  printf ']}\n'
}

# One line per session. Reads the same --json contract the dashboard does, so
# the two can never disagree about what a terminal is doing.
board() {
  local sids w
  sids=$(tt_all_sessions)
  if [ -z "$sids" ]; then echo "No sessions tracked yet."; return 0; fi
  w="${COLUMNS:-0}"
  case "$w" in ''|*[!0-9]*) w=0 ;; esac
  [ "$w" -ge 60 ] || w=$(tput cols 2>/dev/null || echo 100)
  case "$w" in ''|*[!0-9]*) w=100 ;; esac
  [ "$w" -ge 60 ] || w=100

  # shellcheck disable=SC2086
  emit_json $sids | jq -r \
    --argjson w "$w" --argjson ascii "$ASCII" --argjson icons "$ICONS" \
    --arg map "$(tt_icon_rules)" \
    --arg me "$(tt_resolve_session)" \
    --arg dim "$C_DIM" --arg rst "$C_RST" --arg b "$C_B" \
    --arg grn "$C_GRN" --arg yel "$C_YEL" --arg red "$C_RED" --arg cyn "$C_CYN" '
    def clip($n): if $n < 6 then "" elif length > $n then (.[0:$n-1] + "…") else . end;
    def pad($n): . + (" " * ($n - length));
    def ago: (now - .) as $d
      | if . == 0 then "-"
        elif $d < 60    then "\($d | floor)s"
        elif $d < 3600  then "\(($d / 60) | floor)m"
        elif $d < 86400 then "\(($d / 3600) | floor)h"
        else                 "\(($d / 86400) | floor)d" end;
    def icon:
      if $icons == 0 or . == null then ""
      else ((" " + ascii_downcase + " ") | gsub("[^a-z0-9]+"; " ")) as $lt
        | ($map | split(";") | map(split("=") | { i: .[0], p: .[1] })) as $rules
        | ([ $rules[] | .p as $re | select($lt | test(" (" + $re + ")")) ] | .[0].i)
        | if . then . + " " else "" end
      end;

    [ .sessions[]
      | { sid:   .session_id,
          proj:  (.project // "?"),
          st:    .session_status,
          nblk:  (.blocked | length),
          cur:   (if (.blocked | length) > 0 then .blocked[0]
                  else (.current // .next[0]) end),
          live:  (.current != null),
          done:  .summary.done,
          total: (.summary.done + .summary.in_progress + .summary.next),
          upd:   .tree_updated,
          stale: (.since_update.turns // 0),
          has:   .has_tree }
    ]
    | sort_by( (if .nblk > 0 then 0 elif .st == "busy" then 1
                elif .st == "idle" then 2 else 3 end), (- .upd) ) as $r

    | ([ ($r | map(.proj | length) | max // 4), 24 ] | min)                as $pw
    | ($r | map(if .has then "\(.done)/\(.total)" else "" end | length) | max // 0) as $cw
    | ($r | map(if .has then (.upd | ago) else "" end | length) | max // 0)         as $aw
    | ($r | map(if .stale > 0 then "+\(.stale)" else "" end | length) | max // 0)   as $sw
    | (2 + 2 + $pw + 2 + $cw + 2 + $aw + (if $sw > 0 then $sw + 2 else 0 end) + 2) as $lead

    | ( [ "\($r | length) session\(if ($r|length) == 1 then "" else "s" end)",
          (if ($me != "" and ([ $r[] | select(.sid == $me) ] | length) > 0)
             then "you are in \([ $r[] | select(.sid == $me) ] | .[0].proj)" else empty end),
          (if ([ $r[] | select(.nblk > 0) ] | length) > 0
             then "\([ $r[] | select(.nblk > 0) ] | length) blocked" else empty end),
          (if ([ $r[] | select(.stale > 0) ] | length) > 0
             then "\([ $r[] | select(.stale > 0) ] | length) with unrecorded turns" else empty end)
        ] | join(" · ") ) as $head
    | ( $dim + "ttytree · " + $head + $rst ), "",

      ( $r[]
        | .nblk as $nb
        | ( if .nblk > 0    then $red + (if $ascii == 1 then "!" else "⛔" end) + $rst
            elif .st == "busy" then $grn + (if $ascii == 1 then "*" else "●" end) + $rst
            elif .st == "idle" then (if $ascii == 1 then "o" else "○" end)
            else $dim + (if $ascii == 1 then "x" else "✖" end) + $rst end ) as $g
        | ( if .has then "\(.done)/\(.total)" else "" end )                 as $cnt
        | ( if .has then (.upd | ago) else "" end )                        as $age
        | ( if .stale > 0 then "+\(.stale)" else "" end )                  as $stl
        | ( if (.has | not) then $dim + "no tree yet — run /ttytree" + $rst
            elif .cur == null then $dim + "nothing open — tree is clear" + $rst
            else ( (if $nb > 0 then "" elif .live then "▸ " else "○ " end)
                   + (.cur | icon) + (.cur | clip($w - $lead)) )
                 | if $nb > 0 then $red + . + $rst else . end
            end ) as $txt
        | (if .sid == $me then $yel + "› " + $rst else "  " end) as $here
        | $here + $g + " " + $b + (.proj | clip($pw) | pad($pw)) + $rst
          + "  " + $dim + ($cnt | pad($cw)) + "  " + ($age | pad($aw)) + $rst
          + (if $sw > 0 then "  " + $yel + ($stl | pad($sw)) + $rst else "" end)
          + "  " + $txt ),

      "", ( $dim + "   ttytree <name>  one tree in full · "
            + "--all --full  every tree · --serve  browser" + $rst )'
}

if [ "$JSON" = 1 ]; then
  case "$MODE" in
    all)
      sids=""
      for d in "$TTYTREE_HOME"/*/; do [ -d "$d" ] && sids="$sids $(basename "$d")"; done
      # shellcheck disable=SC2086
      emit_json $sids ;;
    *)
      sid="${ARG:-$(tt_resolve_session)}"
      if [ -z "$sid" ]; then printf '{"version":1,"sessions":[]}\n'; exit 0; fi
      emit_json "$sid" ;;
  esac
  exit 0
fi

case "$MODE" in
  all)
    if [ "$FULL" = 0 ]; then
      board
    else
      found=0
      for sid in $(tt_all_sessions); do
        found=1; show_one "$sid"; echo
      done
      if [ "$found" = 0 ]; then echo "No sessions tracked yet."; fi
    fi
    ;;
  path)
    sid=$([ -n "$ARG" ] && tt_match_session "$ARG" || tt_resolve_session)
    [ -n "$sid" ] && tt_tree "$sid" || { echo "not in a Claude Code session" >&2; exit 1; }
    ;;
  events)
    sid=$(tt_resolve_session)
    n="${ARG:-10}"; case "$n" in ''|*[!0-9]*) n=10 ;; esac
    tail -n "$n" "$(tt_events "$sid")" 2>/dev/null | jq -c '{ts,tools,files,dirty,prompt:(.prompt[0:70])}'
    ;;
  next)
    sid=$([ -n "$ARG" ] && tt_match_session "$ARG" || tt_resolve_session)
    tf=$(tt_tree "$sid")
    if [ ! -f "$tf" ]; then
      echo "No tree yet — run /ttytree in this session first." >&2; exit 1
    fi
    header "$sid"
    # Blockers first: they gate everything under them. Flattened to one level —
    # the parents aren't shown, so nested connectors would be lying.
    if grep -qE '^[[:space:]]*- \[[ !]\] ' "$tf" 2>/dev/null; then
      { grep -E '^[[:space:]]*- \[!\] ' "$tf" 2>/dev/null
        grep -E '^[[:space:]]*- \[ \] ' "$tf" 2>/dev/null
      } | sed -e 's/^[[:space:]]*//' | render_tree /dev/stdin
    else
      printf '   %snothing open — tree is clear%s\n' "$C_DIM" "$C_RST"
    fi
    ;;
  watch)
    secs="${ARG:-5}"; case "$secs" in ''|*[!0-9]*) secs=5 ;; esac
    trap 'printf "\033[?25h\n"; exit 0' INT TERM
    printf '\033[?25l'                       # hide cursor
    # carry the display flags into the child render
    fwd=()
    [ "$ASCII" = 1 ] && fwd+=(--ascii)
    [ "$ICONS" = 0 ] && [ "$ASCII" = 0 ] && fwd+=(--no-icons)
    [ "$COLOR" = 0 ] && fwd+=(--no-color)
    [ "$FULL" = 1 ] && fwd+=(--full)
    while :; do
      out=$( "$0" --all "${fwd[@]+"${fwd[@]}"}" 2>&1 )
      printf '\033[H\033[2J'                # home + clear
      printf '%sttytree · %s · refreshing every %ss · ctrl-c to quit%s\n\n' \
        "$C_DIM" "$(date '+%H:%M:%S')" "$secs" "$C_RST"
      printf '%s\n' "$out"
      sleep "$secs"
    done
    ;;
  statusline)
    # Claude Code pipes session JSON on stdin; fall back to the process walk.
    # Never block: stdin may be open but empty (a cron, a bare shell, a test).
    # Give it at most a second to deliver the JSON, then fall back.
    payload=""
    if [ ! -t 0 ]; then
      IFS= read -r -d '' -t 1 payload 2>/dev/null || true
    fi
    sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
    [ -n "$sid" ] || sid=$(tt_resolve_session)
    [ -n "$sid" ] || exit 0
    width="${COLUMNS:-100}"; [ "$width" -lt 40 ] 2>/dev/null && width=100
    json_one "$sid" | jq -r --argjson w "$((width - 2))" \
      --argjson icons "$ICONS" --arg map "$(tt_icon_rules)" '
      def clip($n): if (. | length) > $n then (.[0:$n-1] + "…") else . end;
      # same word-start matching as the tree renderer
      def icon:
        if $icons == 0 or . == null then ""
        else ((" " + ascii_downcase + " ") | gsub("[^a-z0-9]+"; " ")) as $lt
          | ($map | split(";") | map(split("=") | { i: .[0], p: .[1] })) as $rules
          | ([ $rules[] | .p as $re | select($lt | test(" (" + $re + ")")) ] | .[0].i)
          | if . then . + " " else "" end
        end;
      . as $s
      | ($s.project // "?")                                        as $proj
      | ($s.current // $s.next[0] // null)                         as $now
      | ($s.next | map(select(. != $now)) | .[0])                  as $nxt
      | ($s.since_update.turns // 0)                               as $stale
      | ( if $s.has_tree | not then
            "\($proj) · no tree yet — run /ttytree"
          else
            [ "\($proj) · ▸ \($now | icon)\($now // "nothing in progress")" | clip($w),
              ( [ "\($s.summary.done)/\($s.summary.done + $s.summary.in_progress + $s.summary.next) done",
                  (if $stale > 0 then "\($stale) turn(s) unrecorded" else empty end),
                  (if $nxt then "next: \($nxt)" else empty end)
                ] | join(" · ") | clip($w) ),
              ( if ($s.blocked | length) > 0
                then ("⛔ " + ($s.blocked | join("; "))) | clip($w)
                else empty end )
            ] | join("\n")
          end )'
    ;;
  serve|html)
    if ! command -v python3 >/dev/null 2>&1; then
      echo "ttytree: --serve/--html need python3 (the terminal views don't)" >&2; exit 1
    fi
    dash="$SELF_DIR/../lib/dashboard.py"
    if [ ! -f "$dash" ]; then echo "ttytree: missing $dash" >&2; exit 1; fi
    if [ "$MODE" = serve ]; then
      port="${ARG:-7777}"; case "$port" in ''|*[!0-9]*) port=7777 ;; esac
      exec python3 "$dash" --serve "$port" --cli "$SELF_DIR/ttytree" \
                   --icon-map "$(tt_icon_rules)"
    fi
    "$0" --json --all | python3 "$dash" --once --icon-map "$(tt_icon_rules)"
    ;;
  session)
    if [ -n "$ARG" ]; then
      sid=$(tt_match_session "$ARG") || true
      if [ -z "$sid" ]; then
        printf 'ttytree: no session matching %s\n\n' "$ARG" >&2
        printf 'tracked:\n' >&2
        for s in $(tt_all_sessions); do printf '  %s\n' "$(tt_project_of "$s")"; done >&2
        exit 1
      fi
    else
      sid=$(tt_resolve_session)
    fi
    if [ -z "$sid" ]; then
      echo "Not running inside a Claude Code session. Try: ttytree --all" >&2; exit 1
    fi
    show_one "$sid"
    ;;
esac

exit 0
