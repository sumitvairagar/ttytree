#!/usr/bin/env bash
# ttytree :: renderer
#
# Prints the work tree for a Claude Code session. Pure shell — no model call,
# no tokens. `/ttytree` (the skill) is what *updates* the tree; this is
# what displays it, and you can run it any time from any terminal.
#
#   ttytree                 this terminal's session
#   ttytree --all           every session that has a tree
#   ttytree --session <id>  a specific session
#   ttytree --next          only what's actionable right now
#   ttytree --json          machine-readable output (see docs/INTEGRATION.md)
#   ttytree --watch [secs]  live view, redraws every few seconds (default 5)
#   ttytree --statusline    2-3 line summary for Claude Code's statusLine
#   ttytree --events [n]    raw facts captured by the Stop hook
#   ttytree --path          print the tree file path (for editing)
#   ttytree --no-color

set -uo pipefail
# resolve through symlinks — this file is installed as a symlink
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
. "$SELF_DIR/../lib/common.sh"

COLOR=1
[ -t 1 ] || COLOR=0
[ -n "${NO_COLOR:-}" ] && COLOR=0

MODE=session
ARG=""
JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --all|-a)      MODE=all ;;
    --session|-s)  MODE=session; ARG="${2:-}"; shift ;;
    --events|-e)   MODE=events; case "${2:-}" in [0-9]*) ARG="$2"; shift ;; esac ;;
    --path|-p)     MODE=path ;;
    --next|-n)     MODE=next ;;
    --json|-j)     JSON=1 ;;
    --watch|-w)    MODE=watch; case "${2:-}" in [0-9]*) ARG="$2"; shift ;; esac ;;
    --statusline)  MODE=statusline ;;
    --no-color)    COLOR=0 ;;
    -h|--help)     sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            printf 'ttytree: unknown option %s\n' "$1" >&2
                   printf "try 'ttytree --help'\n" >&2; exit 2 ;;
    *)             ARG="$1" ;;
  esac
  shift
done

if [ "$COLOR" = 1 ]; then
  C_DIM=$'\033[2m'; C_RST=$'\033[0m'; C_B=$'\033[1m'
  C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_RED=$'\033[31m'; C_CYN=$'\033[36m'
else
  C_DIM=""; C_RST=""; C_B=""; C_GRN=""; C_YEL=""; C_RED=""; C_CYN=""
fi

render_tree() {
  local file="$1"
  awk -v dim="$C_DIM" -v rst="$C_RST" -v bold="$C_B" \
      -v grn="$C_GRN" -v yel="$C_YEL" -v red="$C_RED" '
    BEGIN { n = 0 }
    function glyph(m) {
      if (m == "x") return grn "✔" rst
      if (m == "~") return yel bold "▸" rst
      if (m == "!") return red "⛔" rst
      if (m == "-") return dim "·" rst
      return "○"
    }
    function paint(m, t) {
      if (m == "x") return dim t rst
      if (m == "~") return bold t rst
      if (m == "!") return red t rst
      if (m == "-") return dim t rst
      return t
    }
    # collect items — portable parse (no gawk-only 3-arg match)
    /^[ \t]*- \[.\] / {
      i = 1; ind = 0
      while (i <= length($0)) {
        c = substr($0, i, 1)
        if (c == " ")      { ind += 1; i += 1 }
        else if (c == "\t") { ind += 2; i += 1 }
        else break
      }
      d[n]  = int(ind / 2)
      mk[n] = substr($0, i + 3, 1)
      tx[n] = substr($0, i + 6)
      n++
      next
    }
    END {
      for (i = 0; i < n; i++) {
        # is this the last sibling at its depth?
        last = 1
        for (j = i + 1; j < n; j++) {
          if (d[j] < d[i]) break
          if (d[j] == d[i]) { last = 0; break }
        }
        pre = ""
        for (k = 0; k < d[i]; k++) pre = pre (cont[k] ? dim "│  " rst : "   ")
        conn = last ? dim "└─ " rst : dim "├─ " rst
        printf "%s%s%s %s\n", pre, conn, glyph(mk[i]), paint(mk[i], tx[i])
        cont[d[i]] = (last ? 0 : 1)
      }
      if (n == 0) printf "%s(tree is empty — run /ttytree to populate it)%s\n", dim, rst
    }
  ' "$file" 2>/dev/null || sed -n 's/^/  /p' "$file"
}

header() {
  local sid="$1" meta name cwd status tty proj
  meta=$(tt_session_meta "$sid")
  if [ -n "$meta" ]; then
    name=$(printf '%s' "$meta"   | jq -r '.name // "?"')
    cwd=$(printf '%s' "$meta"    | jq -r '.cwd // "?"')
    status=$(printf '%s' "$meta" | jq -r '.status // "?"')
    tty=$(printf '%s' "$meta"    | jq -r '.tty // "-"')
  else
    name="(ended)"; status="gone"; tty="-"
    cwd=$(tail -1 "$(tt_events "$sid")" 2>/dev/null | jq -r '.cwd // "?"' 2>/dev/null)
  fi
  proj=$(basename "${cwd:-?}")
  local tf age=""
  tf=$(tt_tree "$sid")
  if [ -f "$tf" ]; then
    age=" · updated $(tt_ago "$(stat -f %m "$tf" 2>/dev/null || stat -c %Y "$tf" 2>/dev/null || echo 0)") ago"
  fi
  printf '%s%s%s  %s%s · %s · %s%s%s\n' \
    "$C_B" "$proj" "$C_RST" "$C_DIM" "$tty" "$status" "${sid:0:8}" "$age" "$C_RST"
}

footer() {
  local sid="$1" ev tree_mt since turns files dirty
  ev=$(tt_events "$sid"); [ -f "$ev" ] || return 0
  tree_mt=$(stat -f %m "$(tt_tree "$sid")" 2>/dev/null || echo 0)
  since=$(jq -s --argjson t "$tree_mt" '
      [ .[] | select(.ts > $t) ]
      | { turns: length,
          files: ([ .[].files[]? ] | unique | length),
          dirty: (last.dirty // 0) }' "$ev" 2>/dev/null)
  [ -n "$since" ] || return 0
  turns=$(printf '%s' "$since" | jq -r '.turns'); files=$(printf '%s' "$since" | jq -r '.files')
  dirty=$(printf '%s' "$since" | jq -r '.dirty')
  [ "$turns" = "0" ] && [ "$dirty" = "0" ] && return 0
  printf '%s' "$C_DIM"
  if [ "$turns" != "0" ]; then
    printf '   %s turn(s), %s file(s) touched since this tree was updated' "$turns" "$files"
    printf ' — run %s/ttytree%s%s to fold them in' "$C_CYN" "$C_RST" "$C_DIM"
  fi
  [ "$dirty" != "0" ] && printf '\n   %s uncommitted file(s)' "$dirty"
  printf '%s\n' "$C_RST"
}

show_one() {
  local sid="$1" tf
  tf=$(tt_tree "$sid")
  header "$sid"
  if [ -f "$tf" ]; then
    grep -v '^<!--' "$tf" | grep -v '^#' | render_tree /dev/stdin
  else
    printf '   %s(no tree yet — run /ttytree in that session)%s\n' "$C_DIM" "$C_RST"
  fi
  footer "$sid"
}


# Parse tree.md into TSV: depth <TAB> state <TAB> text
parse_items() {
  awk '
    BEGIN { FS = "" }
    /^[ \t]*- \[.\] / {
      i = 1; ind = 0
      while (i <= length($0)) {
        c = substr($0, i, 1)
        if (c == " ")       { ind += 1; i += 1 }
        else if (c == "\t") { ind += 2; i += 1 }
        else break
      }
      m = substr($0, i + 3, 1)
      t = substr($0, i + 6)
      st = "next"
      if (m == "x") st = "done"
      else if (m == "~") st = "in_progress"
      else if (m == "!") st = "blocked"
      else if (m == "-") st = "dropped"
      printf "%d\t%s\t%s\n", int(ind / 2), st, t
    }
  ' "$1" 2>/dev/null
}

json_one() {
  local sid="$1" tf ev meta items tree_mt stale
  tf=$(tt_tree "$sid"); ev=$(tt_events "$sid")
  meta=$(tt_session_meta "$sid")
  [ -n "$meta" ] || meta=$(printf '{"sessionId":"%s","cwd":null,"name":null,"status":"gone","pid":null,"tty":null}' "$sid")

  if [ -f "$tf" ]; then
    tree_mt=$(stat -f %m "$tf" 2>/dev/null || stat -c %Y "$tf" 2>/dev/null || echo 0)
    items=$(parse_items "$tf" | jq -R -s '
      [ split("\n")[] | select(length > 0) | split("\t")
        | { depth: (.[0] | tonumber), state: .[1], text: .[2] } ]')
  else
    tree_mt=0; items='[]'
  fi

  stale=$(jq -s --argjson t "${tree_mt:-0}" '
      [ .[] | select((.ts // 0) > $t and (.cold_start // false) == false) ]
      | { turns: length, files: ([ .[].files[]? ] | unique | length),
          dirty: ((last // {}).dirty // 0) }' "$ev" 2>/dev/null) || stale='{"turns":0,"files":0,"dirty":0}'
  [ -n "$stale" ] || stale='{"turns":0,"files":0,"dirty":0}'

  printf '%s' "$meta" | jq -c \
    --argjson items "$items" --argjson stale "$stale" --argjson updated "${tree_mt:-0}" \
    --arg has_tree "$([ -f "$tf" ] && echo true || echo false)" '
    # convenience fields drop a redundant state prefix ("BLOCKED: x" -> "x");
    # items[].text stays verbatim.
    def unprefix: sub("^[[:space:]]*(BLOCKED|Blocked|blocked|DROPPED|Dropped|dropped|TODO|Todo|NEXT|Next)[[:space:]]*[:-][[:space:]]*"; "");
    {
      session_id: .sessionId,
      name:       .name,
      cwd:        .cwd,
      project:    (if .cwd then (.cwd | split("/") | last) else null end),
      tty:        .tty,
      pid:        .pid,
      session_status: .status,
      has_tree:   ($has_tree == "true"),
      tree_updated: $updated,
      items:      $items,
      summary: {
        done:        ([ $items[] | select(.state == "done") ]        | length),
        in_progress: ([ $items[] | select(.state == "in_progress") ] | length),
        next:        ([ $items[] | select(.state == "next") ]        | length),
        blocked:     ([ $items[] | select(.state == "blocked") ]     | length),
        dropped:     ([ $items[] | select(.state == "dropped") ]     | length)
      },
      current: ([ $items[] | select(.state == "in_progress") | .text | unprefix ] | last),
      blocked: [ $items[] | select(.state == "blocked") | .text | unprefix ],
      next:    [ $items[] | select(.state == "next") | .text | unprefix ],
      since_update: $stale
    }'
}

emit_json() {
  local first=1
  printf '{"version":1,"generated_at":%s,"sessions":[' "$(date +%s)"
  for sid in "$@"; do
    [ "$first" = 1 ] || printf ','
    json_one "$sid"
    first=0
  done
  printf ']}\n'
}

if [ "$JSON" = 1 ]; then
  case "$MODE" in
    all)
      sids=""
      for d in "$TTYTREE_HOME"/*/; do [ -d "$d" ] && sids="$sids $(basename "$d")"; done
      # shellcheck disable=SC2086
      emit_json $sids ;;
    *)
      sid="${ARG:-$(tt_resolve_session)}"
      if [ -z "$sid" ]; then printf '{"version":1,"sessions":[]}\n'; exit 0; fi
      emit_json "$sid" ;;
  esac
  exit 0
fi

case "$MODE" in
  all)
    found=0
    for d in "$TTYTREE_HOME"/*/; do
      [ -d "$d" ] || continue
      sid=$(basename "$d"); found=1
      show_one "$sid"; echo
    done
    if [ "$found" = 0 ]; then echo "No sessions tracked yet."; fi
    ;;
  path)
    sid="${ARG:-$(tt_resolve_session)}"; [ -n "$sid" ] && tt_tree "$sid" || echo "not in a Claude Code session" >&2
    ;;
  events)
    sid=$(tt_resolve_session)
    n="${ARG:-10}"; case "$n" in ''|*[!0-9]*) n=10 ;; esac
    tail -n "$n" "$(tt_events "$sid")" 2>/dev/null | jq -c '{ts,tools,files,dirty,prompt:(.prompt[0:70])}'
    ;;
  next)
    sid="${ARG:-$(tt_resolve_session)}"
    tf=$(tt_tree "$sid")
    if [ ! -f "$tf" ]; then
      echo "No tree yet — run /ttytree in this session first." >&2; exit 1
    fi
    header "$sid"
    # blockers first: they gate everything under them
    grep -E '^[ \t]*- \[!\] ' "$tf" 2>/dev/null \
      | sed -E "s/^[ \t]*- \[!\] /   ${C_RED}⛔ /; s/\$/${C_RST}/"
    grep -E '^[ \t]*- \[ \] ' "$tf" 2>/dev/null \
      | sed -E 's/^[ \t]*- \[ \] /   ○ /' \
      || true
    if ! grep -qE '^[ \t]*- \[[ !]\] ' "$tf" 2>/dev/null; then
      printf '   %snothing open — tree is clear%s\n' "$C_DIM" "$C_RST"
    fi
    ;;
  watch)
    secs="${ARG:-5}"; case "$secs" in ''|*[!0-9]*) secs=5 ;; esac
    trap 'printf "\033[?25h\n"; exit 0' INT TERM
    printf '\033[?25l'                       # hide cursor
    while :; do
      out=$( "$0" --all 2>&1 )
      printf '\033[H\033[2J'                # home + clear
      printf '%sttytree · %s · refreshing every %ss · ctrl-c to quit%s\n\n' \
        "$C_DIM" "$(date '+%H:%M:%S')" "$secs" "$C_RST"
      printf '%s\n' "$out"
      sleep "$secs"
    done
    ;;
  statusline)
    # Claude Code pipes session JSON on stdin; fall back to the process walk.
    # Never block: stdin may be open but empty (a cron, a bare shell, a test).
    # Give it at most a second to deliver the JSON, then fall back.
    payload=""
    if [ ! -t 0 ]; then
      IFS= read -r -d '' -t 1 payload 2>/dev/null || true
    fi
    sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
    [ -n "$sid" ] || sid=$(tt_resolve_session)
    [ -n "$sid" ] || exit 0
    width="${COLUMNS:-100}"; [ "$width" -lt 40 ] 2>/dev/null && width=100
    json_one "$sid" | jq -r --argjson w "$((width - 2))" '
      def clip($n): if (. | length) > $n then (.[0:$n-1] + "…") else . end;
      . as $s
      | ($s.project // "?")                                        as $proj
      | ($s.current // $s.next[0] // null)                         as $now
      | ($s.next | map(select(. != $now)) | .[0])                  as $nxt
      | ($s.since_update.turns // 0)                               as $stale
      | ( if $s.has_tree | not then
            "\($proj) · no tree yet — run /ttytree"
          else
            [ "\($proj) · ▸ \($now // "nothing in progress")" | clip($w),
              ( [ "\($s.summary.done)/\($s.summary.done + $s.summary.in_progress + $s.summary.next) done",
                  (if $stale > 0 then "\($stale) turn(s) unrecorded" else empty end),
                  (if $nxt then "next: \($nxt)" else empty end)
                ] | join(" · ") | clip($w) ),
              ( if ($s.blocked | length) > 0
                then ("⛔ " + ($s.blocked | join("; "))) | clip($w)
                else empty end )
            ] | join("\n")
          end )'
    ;;
  session)
    sid="${ARG:-$(tt_resolve_session)}"
    if [ -z "$sid" ]; then
      echo "Not running inside a Claude Code session. Try: ttytree --all" >&2; exit 1
    fi
    show_one "$sid"
    ;;
esac

exit 0
